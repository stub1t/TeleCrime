TELECRIME_TELEGRAM_API_ID=
TELECRIME_TELEGRAM_API_HASH=
TELECRIME_TELEGRAM_PHONE=
# Optional second session file used by housekeeping jobs (watchlist alerts,
# summaries, channel joins) so they no longer skip while the pipeline holds
# the primary session. Authenticate it once with: telecrime telegram-auth-aux
TELECRIME_TELEGRAM_AUX_SESSION_NAME=
TELECRIME_POSTGRES_PASSWORD=change-me
TELECRIME_DATABASE_URL=postgresql://telecrime:change-me@db:5432/telecrime
# Host data directory mounted into the containers. Relative paths are resolved
# from this repository; use an absolute path for an external disk.
TELECRIME_DATA_DIR=./data
# Existing Docker volume name, or a new name for a fresh installation.
TELECRIME_POSTGRES_VOLUME=telecrime_postgres_data
TELECRIME_POSTGRES_PORT=5432
TELECRIME_WEB_PORT=8000
TELECRIME_WORKER_STOP_GRACE_PERIOD=5m
TELECRIME_POSTGRES_SHM_SIZE=1g
TELECRIME_POSTGRES_STATEMENT_TIMEOUT=5min
TELECRIME_POSTGRES_LOCK_TIMEOUT=30s
TELECRIME_POSTGRES_IDLE_TRANSACTION_TIMEOUT=10min
# PostgreSQL memory/WAL tuning for large datasets (defaults are stock Postgres).
# Example for a 16GB RAM host with a 200M+ row credentials table:
# TELECRIME_POSTGRES_SHARED_BUFFERS=8GB
# TELECRIME_POSTGRES_EFFECTIVE_CACHE_SIZE=14GB
# TELECRIME_POSTGRES_WORK_MEM=64MB
# TELECRIME_POSTGRES_MAINTENANCE_WORK_MEM=512MB
# TELECRIME_POSTGRES_MAX_WAL_SIZE=8GB
TELECRIME_DISABLE_STATS_WORKER=0
# Public repository URL shown in the generated channel-list footer
# (e.g. https://github.com/youruser/telecrime). Empty = neutral footer.
TELECRIME_REPO_URL=

# Optional performance overrides. Leave unset to use application defaults.
# TELECRIME_PIPELINE_STALE_SECONDS=1200
# TELECRIME_READY_GROUP_CONCURRENCY=3
# TELECRIME_PARSE_WORKERS=2
