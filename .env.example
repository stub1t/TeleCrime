TELECRIME_TELEGRAM_API_ID=
TELECRIME_TELEGRAM_API_HASH=
TELECRIME_TELEGRAM_PHONE=
# Optional second session file used by housekeeping jobs (watchlist alerts,
# summaries, channel joins) so they no longer skip while the pipeline holds
# the primary session. Authenticate it once with: telecrime telegram-auth-aux
TELECRIME_TELEGRAM_AUX_SESSION_NAME=
TELECRIME_POSTGRES_PASSWORD=change-me
TELECRIME_DATABASE_URL=postgresql://telecrime:change-me@db:5432/telecrime
TELECRIME_DISABLE_STATS_WORKER=0
# Public repository URL shown in the generated channel-list footer
# (e.g. https://github.com/youruser/telecrime). Empty = neutral footer.
TELECRIME_REPO_URL=
